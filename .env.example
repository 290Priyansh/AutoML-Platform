# FastAPI
APP_ENV=development
SECRET_KEY=automldev
ALLOWED_ORIGINS=http://localhost:3000, http://localhost:3003, http://localhost:5173

# Database
POSTGRES_URL=postgresql+asyncpg://user:pass@localhost:5432/automl_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=automl-artifacts
S3_DATA_BUCKET=automl-datasets

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# LLM API keys (Groq primary - free tier available at console.groq.com)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Ollama (local fallback)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# LLM routing (Groq primary - fast, free tier)
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=8192
LLM_TOKEN_BUDGET_PER_AGENT=2000

# Optuna
OPTUNA_N_TRIALS=50
OPTUNA_TIMEOUT_SECONDS=300

# Pipeline
MAX_TRAINING_TIME_SECONDS=1800
MIN_MODELS_TO_TRAIN=5
TOP_N_MODELS=3

# Vector DB
QDRANT_URL=http://qdrant:6333
CHROMA_PATH=./chroma_db